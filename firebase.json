{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "backend/**",
      "test-scam-image.html",
      "app-architecture.html",
      "assets/app-architecture.html",
      "assets/dashboard.html",
      "assets/index.html",
      "assets/report.html",
      "assets/scan.html",
      "**/node_modules/**",
      "**/.git/**",
      "**/__pycache__/**",
      "**/*.pyc"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "fraudshield-backend",
          "region": "us-central1"
        }
      }
    ]
  }
}
